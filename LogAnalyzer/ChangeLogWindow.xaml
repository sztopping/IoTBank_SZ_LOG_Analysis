<Window x:Class="LogAnalyzer.ChangeLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="版本变更记录" Height="560" Width="760"
        WindowStartupLocation="CenterOwner" Background="#FFFFFF"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#111827">
                <Run Text="当前版本："/>
                <Run x:Name="RunVersion" Foreground="#2563EB"/>
            </TextBlock>
            <TextBlock Text="版本变更记录（ChangeLog）" FontSize="12" Foreground="#6B7280" Margin="0,4,0,12"/>
        </StackPanel>

        <ScrollViewer>
            <ItemsControl x:Name="HistoryList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#EEF2FF" CornerRadius="4" Padding="8,3">
                                        <TextBlock Text="{Binding Version}" Foreground="#4338CA" FontWeight="SemiBold" FontSize="13"/>
                                    </Border>
                                    <TextBlock Text="{Binding Date}" Margin="10,0,0,0" Foreground="#6B7280" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Items}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Foreground="#374151" Margin="0,0,0,6"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
