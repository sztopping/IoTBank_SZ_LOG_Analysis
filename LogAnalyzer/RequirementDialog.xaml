<Window x:Class="LogAnalyzer.RequirementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入分析需求" Height="420" Width="560"
        WindowStartupLocation="CenterOwner" Background="#FFFFFF"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="请输入本次日志分析的需求" FontSize="16" FontWeight="SemiBold" Foreground="#111827"/>
            <TextBlock Text="上位机将根据需求内容，自动判断需要调用哪些分析方法，生成专业分析报告。" FontSize="12" Foreground="#6B7280" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <TextBox x:Name="TxtRequirement" Grid.Row="1" Margin="0,16,0,0"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top" Padding="10" FontSize="13"
                 BorderBrush="#D1D5DB" BorderThickness="1"
                 Text="分析各参数随时间的变化趋势，并对比不同设备之间的信号强度差异"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="跳过（全自动分析）" Width="140" Height="36" Margin="0,0,10,0" Click="BtnSkip_Click"/>
            <Button Content="生成报告" Width="120" Height="36" Background="#2563EB" Foreground="White" FontWeight="SemiBold" Click="BtnOk_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
